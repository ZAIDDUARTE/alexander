# Required for production
# Server-only. Not a secret. Used to send https://<host>/ into the questionnaire.
# Example name only: onboard.meetalexander.ai
ONBOARDING_HOST=

# Vercel OIDC → AWS. Identifiers only. Do not put access keys or database passwords here.
AWS_REGION=
AWS_ROLE_ARN=
ALEXANDER_PERSISTENCE_LAMBDA_ARN=

# Optional
# Redis cache. Not required for durable drafts or submissions.
REDIS_URL=

# Development-only
# Explicit local/test fallback. Ignored when NODE_ENV=production.
ALLOW_LOCAL_ONLY_PERSISTENCE=
