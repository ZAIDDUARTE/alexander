# Required for production
# Server-only. Not a secret. Used to send https://<host>/ into the questionnaire.
# Example name only: onboard.meetalexander.ai
ONBOARDING_HOST=

# Preferred alias for invitation URL construction (scheme optional).
# WordPress / payment callback hosts must never be used for questionnaire links.
# Example: https://onboard.meetalexander.ai
ALEXANDER_ONBOARDING_BASE_URL=

# Vercel OIDC → AWS. Identifiers only. Do not put access keys or database passwords here.
AWS_REGION=
AWS_ROLE_ARN=
ALEXANDER_PERSISTENCE_LAMBDA_ARN=

# Optional
# Redis cache. Not required for durable drafts or submissions.
REDIS_URL=

# Development-only
# Explicit local/test fallback. Ignored when NODE_ENV=production.
ALLOW_LOCAL_ONLY_PERSISTENCE=

925039593286-9lvuekg24p919gndkdco7heuuuq0ftqs.apps.googleusercontent.com


# Stripe mode. Staging must stay test. Production live requires an explicit live catalogue.
ALEXANDER_STRIPE_MODE=test

ALEXANDER_STRIPE_SECRET_KEY=__SERVER_SECRET_ONLY__
# Prefer Secrets Manager ARN/name in Vercel/Lambda. Never put real keys here.
ALEXANDER_STRIPE_SECRET_ARN=
ALEXANDER_STRIPE_SECRET_NAME=

# Test catalogue defaults (non-secret). Live mode must set different existing live IDs.
ALEXANDER_STRIPE_PRODUCT_ID=prod_VQf7oFN8EMgfWF
ALEXANDER_STRIPE_PRICE_ID=price_1UPnnEQKy1Smykv0n8NSuxFG
# Live mode only — existing Alexander $500/month product/price (never invent; never use test IDs):
# ALEXANDER_STRIPE_MODE=live
# ALEXANDER_STRIPE_PRODUCT_ID=prod_...
# ALEXANDER_STRIPE_PRICE_ID=price_...

# Customer lifecycle — server secrets only; never commit real values
ALEXANDER_LIFECYCLE_HMAC_SECRET=__SERVER_SECRET_ONLY__
ALEXANDER_LIFECYCLE_HMAC_SECRET_ARN=
ALEXANDER_LIFECYCLE_HMAC_SECRET_NAME=
ALEXANDER_LIFECYCLE_HANDOFF_URL=
ALLOWED_TEST_RECIPIENT=__CONFIGURE_STAGING_TEST_INBOX__
EMAIL_DELIVERY_MODE=test

# Jobber OAuth (staging only). Never commit real secrets.
# Keep ALEXANDER_REQUEST_PIPELINE_ENABLED unset/false while validating OAuth.
JOBBER_OAUTH_ENABLED=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=
JOBBER_GRAPHQL_VERSION=
JOBBER_OAUTH_ENCRYPTION_KEY=
JOBBER_OAUTH_ADMIN_TOKEN=
JOBBER_STAGING_CUSTOMER_ID=
JOBBER_EXPECTED_ACCOUNT_ID=
JOBBER_EXPECTED_ACCOUNT_NAME=

# Request pipeline (staging Preview + Lambda only). Never enable on Production.
ALEXANDER_REQUEST_PIPELINE_ENABLED=
TRILLET_API_KEY=
STAGING_REQUEST_WEBHOOK_TOKEN=
STAGING_REQUEST_READER_TOKEN=
STAGING_REQUEST_INSTALLATION_ID=
STAGING_TRILLET_WORKSPACE_ID=
STAGING_TRILLET_FLOW_ID=
STAGING_TRILLET_AGENT_ID=

# Automated Trillet customer invitations (server-only). Default: feature off, live off.
# Official API: POST /v1/api/workspaces/{workspaceId}/invite (x-api-key + x-workspace-id).
# Trillet sends the invite email; do not invent invitation URLs. SES Email #2 stays separate.
TRILLET_INVITE_ENABLED=
TRILLET_INVITE_LIVE_ENABLED=
# Least-privileged documented role. Do not set admin without permission testing.
TRILLET_CUSTOMER_INVITE_ROLE=viewer
# Comma-separated allowlists for controlled tests (e.g. Alexander Sandbox + ALX-C000001).
TRILLET_INVITE_ALLOWED_WORKSPACE_IDS=
TRILLET_INVITE_ALLOWED_CUSTOMER_NUMBERS=
# Portal entry URL for SES Email #2 (not a Trillet invite token URL).
# Must be HTTPS and allowlisted. portal.meetalexander.ai is blocked until verified.
# Jobber staging/admin hosts are always rejected. Swap this when Agency portal destination is ready.
ALEXANDER_CUSTOMER_DASHBOARD_URL=
# Optional comma-separated HTTPS origins that may appear in Email #2 links.
ALEXANDER_CUSTOMER_DASHBOARD_ALLOWED_ORIGINS=
# Workspace provision policy. Only agency_required is honored; Agency nesting is not in the
# confirmed Trillet API, so automation enters workspace_provisioning_blocked until an operator
# maps an isolated workspace via markTrilletWorkspaceReady.
TRILLET_WORKSPACE_PROVISION_POLICY=agency_required
# Preferred Secrets Manager source for persistence Lambda (JSON { "TRILLET_API_KEY": "..." }).
TRILLET_SECRET_ARN=

# Owner notify (staging allowlist only; default off)
ALEXANDER_REQUEST_OWNER_NOTIFY_ENABLED=
